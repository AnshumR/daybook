# Copy this file to .env.local and fill in the values from
# Supabase → Connect → App Frameworks → Next.js (or Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY works too.

# Optional: make the app private. Only these emails (comma-separated) can use it.
# ALLOWED_EMAILS=you@example.com
